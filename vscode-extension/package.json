{
  "name": "jit-commit-risk",
  "displayName": "JIT Commit Risk Analyzer",
  "description": "Analyze Git commit risk using machine learning, with automatic commit scoring and on-demand analysis of staged changes and previous commits.",
  "version": "0.2.0",
  "publisher": "Janahan",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jana1805/jit-commit-risk.git",
    "directory": "vscode-extension"
  },
  "homepage": "https://github.com/Jana1805/jit-commit-risk/tree/main/vscode-extension#readme",
  "bugs": {
    "url": "https://github.com/Jana1805/jit-commit-risk/issues"
  },
  "keywords": [
    "commit risk",
    "machine learning",
    "git",
    "software quality",
    "defect prediction",
    "deep learning"
  ],
  "galleryBanner": {
    "color": "#18233A",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "jitRisk.scoreStaged",
        "title": "JIT Risk: Score staged changes"
      },
      {
        "command": "jitRisk.scoreLastCommit",
        "title": "JIT Risk: Score last commit"
      }
    ],
    "configuration": {
      "title": "JIT Commit Risk",
      "properties": {
        "jitRisk.apiUrl": {
          "type": "string",
          "default": "https://54-86-64-152.sslip.io",
          "description": "Base URL of the risk prediction API. The default is the public hosted API; change it only if you run your own."
        },
        "jitRisk.apiKey": {
          "type": "string",
          "default": "",
          "description": "Only for self-hosted APIs that require a key: sent as the X-API-Key header. Leave empty for the public API."
        },
        "jitRisk.notify": {
          "type": "string",
          "enum": [
            "risky",
            "always",
            "never"
          ],
          "default": "risky",
          "description": "When to show a notification after a commit is scored. The status bar always updates."
        },
        "jitRisk.timeoutMs": {
          "type": "number",
          "default": 8000,
          "description": "How long to wait for the API before giving up."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "watch": "tsc -watch -p .",
    "test": "tsc -p . && node --test \"out/test/**/*.test.js\"",
    "calibrate": "tsc -p . && node out/calibrate.js",
    "package": "vsce package",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.0.0",
    "typescript": "^5.5.0"
  }
}
